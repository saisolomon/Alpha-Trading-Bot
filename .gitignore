# Environment & secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# C++ build (cpp/libquant)
cpp/build/

# OCaml build (ocaml/libftmorisk)
ocaml/_build/
ocaml/*.install
ocaml/verifier/
# ^ generated by tests/test_ocaml_python_parity.py -- git treats
# trailing same-line comments as part of the pattern, so the comment
# was on its own line above the rule.
# Note: ocaml/*.opam IS committed -- it's auto-generated from dune-project
# but consumers need it to install without dune.

# Virtual environments
.venv/
venv/
env/

# Package managers
.uv/

# Testing
.pytest_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# Mypy
.mypy_cache/

# Ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# Data & logs (generated at runtime)
logs/
data/cache/
data/*.parquet
data/*.csv
# Reports: gitignored by default, EXCEPT the paper-trade run reports the
# cloud routine commits (so the human reviewer can audit the 4-week run
# end-to-end from git history).
reports/
!reports/paper_trade/
# Paper-trade JSONL snapshots MUST be committed -- the local monitor
# pushes them hourly and the cloud routine pulls them for review. Do
# NOT gitignore data/paper_trade/.

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# OCaml interface files generated by the libftmorisk build attempt
ocaml/lib/*.cmi
ocaml/lib/*.cmx
ocaml/lib/*.o

# Node / Convex CLI dependencies (~54MB of TypeScript tooling).
# NOTE: convex/_generated/ IS committed -- it's the codegen output the
# convex/ TypeScript files import from. Skipping it would break
# `npx convex deploy` on a fresh checkout.
node_modules/
.convex/

# TypeScript build cache (Convex CLI generates these)
*.tsbuildinfo

# Reproducible historical-data cache (pulled by backtest/fetch_history.py)
data/history/
