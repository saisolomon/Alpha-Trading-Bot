# MetaTrader 5 credentials — copy to .env and fill in real values
# .env is gitignored; NEVER commit real credentials

# MT5 account number (integer)
MT5_LOGIN=12345678

# MT5 account password
MT5_PASSWORD=your_password_here

# MT5 broker server name (exact string from the terminal's login screen)
MT5_SERVER=BrokerName-Server

# Optional: full path to the MT5 terminal executable.
# Leave empty to let the library auto-detect (works if MT5 is installed in the default location).
MT5_PATH=

# FTMO account type for the active session.
# Allowed values: CHALLENGE_1STEP | CHALLENGE_2STEP_PHASE1 | CHALLENGE_2STEP_PHASE2
#                 FUNDED_STANDARD | FUNDED_SWING | FUNDED_REWARDS_1STEP
FTMO_ACCOUNT_TYPE=CHALLENGE_2STEP_PHASE1

# Initial sim capital in account currency (the starting balance when the Challenge/account was opened).
# All FTMO percentage limits are calculated from this number.
FTMO_INITIAL_CAPITAL=25000.0

# Environment tag — controls assertion levels, log verbosity, etc.
# Allowed values: dev | paper | live
ENV=dev
